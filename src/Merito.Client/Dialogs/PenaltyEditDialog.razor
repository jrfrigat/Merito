@inherits DialogBase

<FlareStack Gap="FlareSpacing.Medium">
    @if (Error is not null)
    {
        <FlareAlert Severity="AlertSeverity.Error" Variant="AlertVariant.Outlined">@Error</FlareAlert>
    }
    <FlareTextField @ref="_titleField" @bind-Value="_title" Label="Нарушение" MaxLength="Limits.TitleMaxLength" Required Autofocus
                    ErrorText="@_fieldErrors["title"]" />
    <FlareNumericField TValue="int" @ref="_pointsField" @bind-Value="_points" Label="Сколько баллов списать" Min="1" Max="Limits.PointsMax" SelectAllOnFocus
                       ErrorText="@_fieldErrors["points"]" />
    <FlareStack Row Align="FlareAlignItems.Center" Justify="@(Penalty is null ? FlareJustifyContent.End : FlareJustifyContent.SpaceBetween)" Gap="FlareSpacing.Small">
        @if (Penalty is not null)
        {
            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Delete" AriaLabel="Удалить штраф" Color="FlareColor.Error" Disabled="Busy"
                             OnClick="@(() => DeleteAsync(Penalty.Title, () => Api.DeletePenaltyAsync(Session.FamilyId, Penalty.Id)))" />
        }
        <FlareStack Row Gap="FlareSpacing.Small">
            <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => Dialog.Cancel())">Отмена</FlareButton>
            <FlareButton Loading="Busy" OnClick="SaveAsync">Сохранить</FlareButton>
        </FlareStack>
    </FlareStack>
</FlareStack>

@code {
    /// <summary>The penalty to edit; null to add a new one.</summary>
    [Parameter] public PenaltyDto? Penalty { get; set; }

    private string? _title;
    private int _points = 5;
    private readonly FieldErrors _fieldErrors = new();
    private FlareEditableFieldBase? _titleField;
    private FlareEditableFieldBase? _pointsField;

    protected override void OnInitialized()
    {
        if (Penalty is not null) (_title, _points) = (Penalty.Title, Penalty.Points);
    }

    private async Task SaveAsync()
    {
        _fieldErrors.Clear();
        if (string.IsNullOrWhiteSpace(_title)) _fieldErrors["title"] = "Заполните поле \"Нарушение\".";
        if (_points is < 1 or > Limits.PointsMax) _fieldErrors["points"] = $"Баллы от 1 до {Limits.PointsMax}.";
        if (_fieldErrors.HasErrors)
        {
            await _fieldErrors.FocusFirstAsync(("title", _titleField), ("points", _pointsField));
            return;
        }

        var request = new PenaltyRequest(_title ?? "", _points);
        await SubmitAsync(() => Penalty is null
            ? Api.AddPenaltyAsync(Session.FamilyId, request)
            : Api.UpdatePenaltyAsync(Session.FamilyId, Penalty.Id, request));
    }
}
