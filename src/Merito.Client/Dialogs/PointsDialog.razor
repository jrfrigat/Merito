@inherits DialogBase

<FlareStack Gap="FlareSpacing.Medium">
    @if (Error is not null)
    {
        <FlareAlert Severity="AlertSeverity.Error" Variant="AlertVariant.Outlined">@Error</FlareAlert>
    }
    <FlareText Typo="TypographyScale.BodyMedium">@Child.DisplayName, на счету @Format.Points(Child.Balance ?? 0)</FlareText>

    <FlareToggleGroup TValue="PointsMode?" @bind-Value="_mode" Mandatory Size="ButtonSize.Sm">
        <FlareToggleButton Value="PointsMode.Bonus">Начислить</FlareToggleButton>
        <FlareToggleButton Value="PointsMode.Deduct">Списать</FlareToggleButton>
        <FlareToggleButton Value="PointsMode.Penalty">Штраф</FlareToggleButton>
    </FlareToggleGroup>

    @if (_mode == PointsMode.Penalty)
    {
        <FlareSelect TValue="PenaltyDto" @bind-Value="_penalty" Items="Penalties" Label="Нарушение" Searchable
                     ItemLabel="@(p => p is null ? "" : $"{p.Title} (-{p.Points})")" NoResultsText="Ничего не найдено"
                     ErrorText="@_fieldErrors["penalty"]" />
        @if (Penalties.Count == 0)
        {
            <FlareText Typo="TypographyScale.BodySmall">Список штрафов пуст - добавьте их в разделе "Каталог".</FlareText>
        }
    }
    else
    {
        <FlareNumericField TValue="int" @ref="_amountField" @bind-Value="_amount" Label="Баллы" Min="1" Max="Limits.PointsMax" ShowStepper SelectAllOnFocus
                           ErrorText="@_fieldErrors["amount"]" />
    }

    <FlareTextArea @ref="_commentField" @bind-Value="_comment" Rows="2" AutoGrow MaxLength="Limits.TextMaxLength"
                   ErrorText="@_fieldErrors["comment"]"
                   Label="@(_mode == PointsMode.Penalty ? "Комментарий (необязательно)" : "За что (обязательно)")" />

    <FlareStack Row Wrap Gap="FlareSpacing.Small" Justify="FlareJustifyContent.End">
        <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => Dialog.Cancel())">Отмена</FlareButton>
        <FlareButton Loading="Busy" Color="@(_mode == PointsMode.Bonus ? FlareColor.Success : FlareColor.Error)" OnClick="SaveAsync">
            @ActionText
        </FlareButton>
    </FlareStack>
</FlareStack>

@code {
    /// <summary>The child whose balance changes.</summary>
    [Parameter, EditorRequired] public MemberDto Child { get; set; } = default!;

    /// <summary>The family's penalties.</summary>
    [Parameter] public IReadOnlyList<PenaltyDto> Penalties { get; set; } = [];

    /// <summary>The tab the dialog opens on.</summary>
    [Parameter] public PointsMode Mode { get; set; } = PointsMode.Bonus;

    private PointsMode? _mode;
    private int _amount = 5;
    private PenaltyDto? _penalty;
    private string? _comment;
    private readonly FieldErrors _fieldErrors = new();
    private FlareEditableFieldBase? _amountField;
    private FlareEditableFieldBase? _commentField;

    private string ActionText => _mode switch
    {
        PointsMode.Bonus => "Начислить",
        PointsMode.Deduct => "Списать",
        _ => "Оштрафовать",
    };

    protected override void OnInitialized() => _mode = Mode;

    private async Task SaveAsync()
    {
        _fieldErrors.Clear();
        if (_mode == PointsMode.Penalty)
        {
            if (_penalty is null) _fieldErrors["penalty"] = "Выберите нарушение.";
        }
        else
        {
            if (_amount is < 1 or > Limits.PointsMax) _fieldErrors["amount"] = $"Баллы от 1 до {Limits.PointsMax}.";
            if (string.IsNullOrWhiteSpace(_comment)) _fieldErrors["comment"] = "Напишите, за что.";
        }
        if (_fieldErrors.HasErrors)
        {
            await _fieldErrors.FocusFirstAsync(("amount", _amountField), ("comment", _commentField));
            return;
        }

        await SubmitAsync(async () =>
        {
            if (_mode == PointsMode.Penalty)
                await Api.ApplyPenaltyAsync(Session.FamilyId, new ApplyPenaltyRequest(Child.Id, _penalty!.Id, _comment));
            else
                await Api.AdjustPointsAsync(Session.FamilyId, new AdjustPointsRequest(Child.Id,
                    _mode == PointsMode.Bonus ? _amount : -_amount, _comment ?? ""));
        });
    }

    /// <summary>What the parent is about to do.</summary>
    public enum PointsMode
    {
        /// <summary>Grant points.</summary>
        Bonus,

        /// <summary>Deduct points by hand.</summary>
        Deduct,

        /// <summary>Apply a catalog penalty.</summary>
        Penalty,
    }
}
