@inherits DialogBase

<FlareStack Gap="FlareSpacing.Medium">
    @if (Error is not null)
    {
        <FlareAlert Severity="AlertSeverity.Error" Variant="AlertVariant.Outlined">@Error</FlareAlert>
    }
    <FlareTextField @ref="_titleField" @bind-Value="_title" Label="Задание" MaxLength="Limits.TitleMaxLength" Required Autofocus
                    ErrorText="@_fieldErrors["title"]" />
    <FlareToggleGroup TValue="TaskCategory?" @bind-Value="_category" Mandatory Size="ButtonSize.Sm">
        <FlareToggleButton Value="TaskCategory.Daily">Ежедневное</FlareToggleButton>
        <FlareToggleButton Value="TaskCategory.Extra">Дополнительное</FlareToggleButton>
    </FlareToggleGroup>
    <FlareStack Row Gap="FlareSpacing.Small" StretchItems>
        <FlareNumericField TValue="int" @ref="_pointsField" @bind-Value="_points" Label="Баллы" Min="1" Max="Limits.PointsMax" SelectAllOnFocus
                           ErrorText="@_fieldErrors["points"]" />
        <FlareNumericField TValue="int?" @ref="_maxPointsField" @bind-Value="_maxPoints" Label="До (если диапазон)" Min="1" Max="Limits.PointsMax" Clearable
                           ErrorText="@_fieldErrors["maxPoints"]" />
    </FlareStack>
    <FlareTextField @bind-Value="_timeOfDay" Label="Когда" Placeholder="утро, вечер, весь день" MaxLength="Limits.TimeOfDayMaxLength" />
    <FlareTextArea @bind-Value="_description" Label="Подробности" Rows="2" AutoGrow MaxLength="Limits.TextMaxLength" />
    <FlareStack Row Align="FlareAlignItems.Center" Justify="@(Task is null ? FlareJustifyContent.End : FlareJustifyContent.SpaceBetween)" Gap="FlareSpacing.Small">
        @if (Task is not null)
        {
            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Delete" AriaLabel="Удалить задание" Color="FlareColor.Error" Disabled="Busy"
                             OnClick="@(() => DeleteAsync(Task.Title, () => Api.DeleteTaskAsync(Session.FamilyId, Task.Id)))" />
        }
        <FlareStack Row Gap="FlareSpacing.Small">
            <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => Dialog.Cancel())">Отмена</FlareButton>
            <FlareButton Loading="Busy" OnClick="SaveAsync">Сохранить</FlareButton>
        </FlareStack>
    </FlareStack>
</FlareStack>

@code {
    /// <summary>The task to edit; null to add a new one.</summary>
    [Parameter] public TaskDto? Task { get; set; }

    private string? _title;
    private string? _description;
    private string? _timeOfDay;
    private int _points = 1;
    private int? _maxPoints;
    private TaskCategory? _category = TaskCategory.Daily;
    private readonly FieldErrors _fieldErrors = new();
    private FlareEditableFieldBase? _titleField;
    private FlareEditableFieldBase? _pointsField;
    private FlareEditableFieldBase? _maxPointsField;

    protected override void OnInitialized()
    {
        if (Task is null) return;
        (_title, _description, _timeOfDay, _points, _maxPoints, _category) =
            (Task.Title, Task.Description, Task.TimeOfDay, Task.Points, Task.MaxPoints, Task.Category);
    }

    private async Task SaveAsync()
    {
        _fieldErrors.Clear();
        if (string.IsNullOrWhiteSpace(_title)) _fieldErrors["title"] = "Заполните поле \"Задание\".";
        if (_points is < 1 or > Limits.PointsMax) _fieldErrors["points"] = $"Баллы от 1 до {Limits.PointsMax}.";
        if (_maxPoints is { } max && max < _points) _fieldErrors["maxPoints"] = "Верхняя граница не меньше нижней.";
        if (_fieldErrors.HasErrors)
        {
            await _fieldErrors.FocusFirstAsync(
                ("title", _titleField), ("points", _pointsField), ("maxPoints", _maxPointsField));
            return;
        }

        var request = new TaskRequest(_title ?? "", _description, _points, _maxPoints, _category ?? TaskCategory.Daily, _timeOfDay);
        await SubmitAsync(() => Task is null
            ? Api.AddTaskAsync(Session.FamilyId, request)
            : Api.UpdateTaskAsync(Session.FamilyId, Task.Id, request));
    }
}
