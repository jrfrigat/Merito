@inherits DialogBase

<FlareStack Gap="FlareSpacing.Medium">
    @if (Error is not null)
    {
        <FlareAlert Severity="AlertSeverity.Error" Variant="AlertVariant.Outlined">@Error</FlareAlert>
    }
    <FlareTextField @bind-Value="_title" Label="Задание" MaxLength="Limits.TitleMaxLength" Required Autofocus />
    <FlareToggleGroup TValue="TaskCategory" @bind-Value="_category" Mandatory>
        <FlareToggleButton Value="TaskCategory.Daily">Ежедневное</FlareToggleButton>
        <FlareToggleButton Value="TaskCategory.Extra">Дополнительное</FlareToggleButton>
    </FlareToggleGroup>
    <FlareStack Row Gap="FlareSpacing.Small" StretchItems>
        <FlareNumericField TValue="int" @bind-Value="_points" Label="Баллы" Min="1" Max="Limits.PointsMax" SelectAllOnFocus />
        <FlareNumericField TValue="int?" @bind-Value="_maxPoints" Label="До (если диапазон)" Min="1" Max="Limits.PointsMax" Clearable />
    </FlareStack>
    <FlareTextField @bind-Value="_timeOfDay" Label="Когда" Placeholder="утро, вечер, весь день" MaxLength="Limits.TimeOfDayMaxLength" />
    <FlareTextArea @bind-Value="_description" Label="Подробности" Rows="2" AutoGrow MaxLength="Limits.TextMaxLength" />
    <FlareStack Row Wrap Gap="FlareSpacing.Small" Justify="FlareJustifyContent.End">
        <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => Dialog.Cancel())">Отмена</FlareButton>
        <FlareButton Loading="Busy" OnClick="SaveAsync">Сохранить</FlareButton>
    </FlareStack>
</FlareStack>

@code {
    /// <summary>The task to edit; null to add a new one.</summary>
    [Parameter] public TaskDto? Task { get; set; }

    private string? _title;
    private string? _description;
    private string? _timeOfDay;
    private int _points = 1;
    private int? _maxPoints;
    private TaskCategory _category = TaskCategory.Daily;

    protected override void OnInitialized()
    {
        if (Task is null) return;
        (_title, _description, _timeOfDay, _points, _maxPoints, _category) =
            (Task.Title, Task.Description, Task.TimeOfDay, Task.Points, Task.MaxPoints, Task.Category);
    }

    private Task SaveAsync()
    {
        var request = new TaskRequest(_title ?? "", _description, _points, _maxPoints, _category, _timeOfDay);
        return SubmitAsync(() => Task is null
            ? Api.AddTaskAsync(Session.FamilyId, request)
            : Api.UpdateTaskAsync(Session.FamilyId, Task.Id, request));
    }
}
