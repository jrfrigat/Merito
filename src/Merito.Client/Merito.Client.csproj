<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Icon catalog members are separate static getters in trimmable packages, so a Release publish
         ships only the icons the app references. -->
    <PublishTrimmed>true</PublishTrimmed>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Flare.Blazor" />
    <PackageReference Include="Flare.Theme.MaterialDesign3Expressive" />
    <PackageReference Include="Flare.Icons.MaterialDesign3.Svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Merito.Shared\Merito.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
