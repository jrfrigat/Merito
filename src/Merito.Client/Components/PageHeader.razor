@* The title row of a page, with optional actions that wrap below the title on a narrow screen. *@
<FlareStack Row Wrap Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
    <FlareStack Gap="FlareSpacing.None">
        <FlareText Typo="TypographyScale.HeadlineSmall" Element="h1">@Title</FlareText>
        @if (Subtitle is not null)
        {
            <FlareText Typo="TypographyScale.BodyMedium">@Subtitle</FlareText>
        }
    </FlareStack>
    @if (Actions is not null)
    {
        <FlareStack Row Wrap Gap="FlareSpacing.Small">@Actions</FlareStack>
    }
</FlareStack>

@code {
    /// <summary>Page title.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Optional line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Buttons shown beside the title.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
