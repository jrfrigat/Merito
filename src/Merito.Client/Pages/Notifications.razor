@page "/notifications"
@inject ApiClient Api
@inject Session Session
@inject NotificationCenter NotificationCenter
@inject IDialogService Dialogs
@inject ISnackbarService Snackbar

<PageTitle>Уведомления - Merito</PageTitle>

<FlareStack Gap="FlareSpacing.Large">
    <PageHeader Title="Уведомления" Subtitle="События по баллам и проверке дел">
        <Actions>
            @if (_items?.Any(x => x.ReadAt is null) == true)
            {
                <FlareButton Variant="ButtonVariant.Text" Loading="_markingAll" OnClick="MarkAllReadAsync">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.DoneAll" /></LeadingIcon>
                    <ChildContent>Прочитать все</ChildContent>
                </FlareButton>
            }
        </Actions>
    </PageHeader>

    <FlareAlert Severity="@PushSeverity" Variant="AlertVariant.Outlined" Title="@PushTitle">
        <FlareStack Gap="FlareSpacing.Small" Align="FlareAlignItems.Start">
            <FlareText Typo="TypographyScale.BodyMedium">@PushDescription</FlareText>
            @if (NotificationCenter.PushState == "disabled")
            {
                <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" Loading="_changingPush" OnClick="EnablePushAsync">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.NotificationsActive" /></LeadingIcon>
                    <ChildContent>Включить уведомления</ChildContent>
                </FlareButton>
            }
            else if (NotificationCenter.PushState == "error")
            {
                <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" Loading="_changingPush" OnClick="RetryPushAsync">
                    Попробовать снова
                </FlareButton>
            }
            else if (NotificationCenter.PushState == "enabled")
            {
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Loading="_changingPush" OnClick="DisablePushAsync">
                    Отключить для этого браузера
                </FlareButton>
            }
        </FlareStack>
    </FlareAlert>

    <LoadState Loading="_items is null" Error="@_error" OnRetry="LoadAsync">
        @if (_items is { Count: 0 })
        {
            <FlareEmptyState Title="Пока нет уведомлений" Description="Здесь появятся изменения баллов и результаты проверки дел.">
                <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Notifications" Size="2.5rem" /></IconContent>
            </FlareEmptyState>
        }
        else
        {
            <FlareStack Gap="FlareSpacing.Small">
                @foreach (var item in _items ?? [])
                {
                    var unread = item.ReadAt is null;
                    <FlareCard @key="item.Id" Variant="@(unread ? CardVariant.Filled : CardVariant.Outlined)">
                        <FlareCardContent>
                            <FlareStack Row Align="FlareAlignItems.Start" Gap="FlareSpacing.Medium">
                                <FlareAvatar Color="@Color(item.Kind)" Size="AvatarSize.Sm">
                                    <FallbackContent><FlareIconView Value="@Icon(item.Kind)" /></FallbackContent>
                                </FlareAvatar>
                                <FlareStack Gap="FlareSpacing.XSmall" Style="flex:1;min-width:0;">
                                    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                        <FlareText Typo="TypographyScale.TitleMedium" Weight="@(unread ? FontWeight.Bold : FontWeight.Medium)">@item.Title</FlareText>
                                        @if (unread)
                                        {
                                            <span aria-label="Непрочитано" style="width:.55rem;height:.55rem;border-radius:50%;background:var(--flare-color-primary,#6750a4);flex:none;"></span>
                                        }
                                    </FlareStack>
                                    <FlareText Typo="TypographyScale.BodyMedium">@item.Message</FlareText>
                                    <FlareText Typo="TypographyScale.LabelSmall">@Format.When(item.CreatedAt)</FlareText>
                                    @if (item.Purchase is { } purchase)
                                    {
                                        <FlareStack Gap="FlareSpacing.XSmall">
                                            <FlareText Typo="TypographyScale.TitleSmall" Weight="FontWeight.Medium">@purchase.Title</FlareText>
                                            <FlareText Typo="TypographyScale.BodySmall">@($"{purchase.ChildName} - {Format.Points(purchase.Cost)}")</FlareText>
                                            <FlareStack Row>
                                                <FlareChip Label="@PurchaseStatusLabel(purchase.Status)" Color="@PurchaseStatusColor(purchase.Status)" Size="ChipSize.Sm" />
                                            </FlareStack>
                                            @if (PurchaseResolution(purchase) is { } resolution)
                                            {
                                                <FlareText Typo="TypographyScale.LabelSmall">@resolution</FlareText>
                                            }
                                        </FlareStack>
                                    }
                                </FlareStack>
                            </FlareStack>
                        </FlareCardContent>
                        @if (item.Purchase is { CanFulfill: true } or { CanCancel: true })
                        {
                            <FlareCardActions Align="CardActionsAlign.End" Wrap>
                                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Color="FlareColor.Error"
                                             Loading="@(_acting == item.Id && _cancelling)" Disabled="@(_acting is not null || _marking is not null)"
                                             OnClick="@(() => CancelPurchaseAsync(item))">Отменить и вернуть</FlareButton>
                                <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Sm"
                                             Loading="@(_acting == item.Id && !_cancelling)" Disabled="@(_acting is not null || _marking is not null)"
                                             OnClick="@(() => FulfillPurchaseAsync(item))">Выдать</FlareButton>
                            </FlareCardActions>
                        }
                        else if (unread)
                        {
                            <FlareCardActions Align="CardActionsAlign.End">
                                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                                             Loading="@(_marking == item.Id)" Disabled="@(_marking is not null)"
                                             OnClick="@(() => MarkReadAsync(item))">Прочитано</FlareButton>
                            </FlareCardActions>
                        }
                    </FlareCard>
                }
            </FlareStack>
        }
    </LoadState>
</FlareStack>

@code {
    private List<NotificationDto>? _items;
    private string? _error;
    private Guid? _marking;
    private Guid? _acting;
    private bool _cancelling;
    private bool _markingAll;
    private bool _changingPush;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _items = await Api.GetNotificationsAsync(Session.FamilyId, take: 100);
            await NotificationCenter.RefreshAsync();
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    private async Task MarkReadAsync(NotificationDto item)
    {
        if (item.ReadAt is not null || _marking is not null) return;
        _marking = item.Id;
        _error = null;
        try
        {
            await Api.MarkNotificationReadAsync(Session.FamilyId, item.Id);
            Replace(item with { ReadAt = DateTime.UtcNow });
            await NotificationCenter.RefreshAsync();
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _marking = null;
        }
    }

    private async Task MarkAllReadAsync()
    {
        if (_items is null || _markingAll) return;
        _markingAll = true;
        _error = null;
        try
        {
            await Api.MarkAllNotificationsReadAsync(Session.FamilyId);
            var readAt = DateTime.UtcNow;
            _items = _items.Select(x => x.ReadAt is null ? x with { ReadAt = readAt } : x).ToList();
            await NotificationCenter.RefreshAsync();
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _markingAll = false;
        }
    }

    private Task FulfillPurchaseAsync(NotificationDto item) =>
        RunPurchaseActionAsync(item, false,
            () => Api.FulfillNotificationPurchaseAsync(Session.FamilyId, item.Id),
            "Покупка отмечена как выданная");

    private async Task CancelPurchaseAsync(NotificationDto item)
    {
        if (item.Purchase is not { } purchase ||
            await Dialogs.ConfirmAsync("Отменить покупку?",
                $"{Format.Points(purchase.Cost)} вернутся на счет {purchase.ChildName}.",
                "Отменить покупку", "Нет") != true)
            return;

        await RunPurchaseActionAsync(item, true,
            () => Api.CancelNotificationPurchaseAsync(Session.FamilyId, item.Id),
            "Покупка отменена, баллы возвращены");
    }

    private async Task RunPurchaseActionAsync(NotificationDto item, bool cancelling, Func<Task> action, string done)
    {
        if (_acting is not null) return;
        _acting = item.Id;
        _cancelling = cancelling;
        try
        {
            await action();
            Snackbar.Show(done, SnackbarSeverity.Success);
        }
        catch (ApiException e)
        {
            Snackbar.Show(e.Message, SnackbarSeverity.Error);
        }
        finally
        {
            _acting = null;
            _cancelling = false;
            await LoadAsync();
        }
    }

    private async Task EnablePushAsync()
    {
        if (_changingPush) return;
        _changingPush = true;
        try
        {
            await NotificationCenter.EnablePushAsync();
        }
        finally
        {
            _changingPush = false;
        }
    }

    private async Task DisablePushAsync()
    {
        if (_changingPush) return;
        _changingPush = true;
        try
        {
            await NotificationCenter.DisablePushAsync();
        }
        finally
        {
            _changingPush = false;
        }
    }

    private async Task RetryPushAsync()
    {
        if (_changingPush) return;
        _changingPush = true;
        try
        {
            await NotificationCenter.RefreshPushStateAsync();
        }
        finally
        {
            _changingPush = false;
        }
    }

    private AlertSeverity PushSeverity => NotificationCenter.PushState switch
    {
        "enabled" => AlertSeverity.Success,
        "denied" or "unsupported" => AlertSeverity.Warning,
        "error" => AlertSeverity.Error,
        _ => AlertSeverity.Info,
    };

    private string PushTitle => NotificationCenter.PushState switch
    {
        "loading" => "Проверяем уведомления",
        "unavailable" => "Web Push пока не настроен",
        "unsupported" => "Браузер не поддерживает Web Push",
        "denied" => "Уведомления запрещены в браузере",
        "enabled" => "Уведомления включены",
        "error" => "Не получилось настроить уведомления",
        _ => "Получайте уведомления сразу",
    };

    private string PushDescription => NotificationCenter.PushState switch
    {
        "loading" => "Проверяем настройки этого браузера.",
        "unavailable" => "Администратору нужно добавить VAPID-ключи на сервере. Уведомления внутри приложения продолжают работать.",
        "unsupported" => "Используйте современный браузер с поддержкой service worker и Push API.",
        "denied" => "Разрешите уведомления в настройках браузера, затем перезагрузите страницу.",
        "enabled" => "Этот браузер сообщит о новых начислениях, списаниях и результатах проверки.",
        "error" => NotificationCenter.PushError ?? "Повторите попытку чуть позже.",
        _ => "Разрешение браузера появится только после нажатия кнопки.",
    };

    private void Replace(NotificationDto replacement)
    {
        if (_items is null) return;
        var index = _items.FindIndex(x => x.Id == replacement.Id);
        if (index >= 0) _items[index] = replacement;
    }

    private static FlareIcon Icon(NotificationKind kind) => kind switch
    {
        NotificationKind.PointsCredited => MaterialDesign3Icons.Regular.AddCircle,
        NotificationKind.PointsDebited => MaterialDesign3Icons.Regular.DoNotDisturbOn,
        NotificationKind.SubmissionApproved => MaterialDesign3Icons.Regular.CheckCircle,
        NotificationKind.SubmissionRejected => MaterialDesign3Icons.Regular.Cancel,
        _ => MaterialDesign3Icons.Regular.Notifications,
    };

    private static FlareColor Color(NotificationKind kind) => kind switch
    {
        NotificationKind.PointsCredited or NotificationKind.SubmissionApproved => FlareColor.Success,
        NotificationKind.PointsDebited or NotificationKind.SubmissionRejected => FlareColor.Error,
        _ => FlareColor.Primary,
    };

    private static string PurchaseStatusLabel(PurchaseStatus status) => status switch
    {
        PurchaseStatus.Pending => "Ждет решения",
        PurchaseStatus.Fulfilled => "Выдано",
        PurchaseStatus.Cancelled => "Отменено",
        _ => status.ToString(),
    };

    private static FlareColor PurchaseStatusColor(PurchaseStatus status) => status switch
    {
        PurchaseStatus.Fulfilled => FlareColor.Success,
        PurchaseStatus.Cancelled => FlareColor.Error,
        _ => FlareColor.Tertiary,
    };

    private static string? PurchaseResolution(NotificationPurchaseDto purchase) => purchase.ResolvedAt is { } resolvedAt
        ? $"{purchase.ResolverName ?? "Родитель"} - {Format.When(resolvedAt)}"
        : null;
}
