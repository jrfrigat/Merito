@page "/start"
@layout AuthLayout
@inject ApiClient Api
@inject Session Session
@inject NavigationManager Nav

<PageTitle>Семья - Merito</PageTitle>

@if (Session.Me is { } me)
{
    <FlareStack Gap="FlareSpacing.Medium">
        <FlareText Typo="TypographyScale.TitleMedium" Align="TextAlign.Center" Element="h1">
            @(me.Families.Count == 0 ? $"{me.DisplayName}, начнем с семьи" : "Еще одна семья")
        </FlareText>

        @if (_createError is not null)
        {
            <FlareAlert Severity="AlertSeverity.Error" Variant="AlertVariant.Outlined">@_createError</FlareAlert>
        }

        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="Создать семью" Subtitle="Вы станете родителем и настроите задания, штрафы и магазин">
                <AvatarContent><FlareIconView Value="@MaterialDesign3Icons.Regular.FamilyRestroom" Color="FlareColor.Primary" Size="2rem" /></AvatarContent>
            </FlareCardHeader>
            <FlareCardContent>
                <FlareStack Gap="FlareSpacing.Medium">
                    <FlareTextField @ref="_familyNameField" @bind-Value="_familyName" Label="Название семьи" Placeholder="Например, Ивановы"
                                    MaxLength="Limits.NameMaxLength" ErrorText="@_createFieldErrors["name"]" />
                    <FlareSwitch @bind-Value="_seedExample" Label="Заполнить примером: 21 задание, 7 штрафов и магазин экранного времени" />
                    <FlareButton FullWidth Loading="_creating" OnClick="CreateAsync">Создать</FlareButton>
                </FlareStack>
            </FlareCardContent>
        </FlareCard>

        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="Вступить по коду" Subtitle="@("Код дает родитель в разделе \"Семья\"")">
                <AvatarContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Key" Color="FlareColor.Secondary" Size="2rem" /></AvatarContent>
            </FlareCardHeader>
            <FlareCardContent>
                <FlareStack Gap="FlareSpacing.Medium">
                    @if (_joinError is not null)
                    {
                        <FlareAlert Severity="AlertSeverity.Error" Variant="AlertVariant.Outlined">@_joinError</FlareAlert>
                    }
                    <FlareTextField @ref="_codeField" @bind-Value="_code" Label="Код приглашения" Placeholder="ABCD2345" Autocomplete="off"
                                    ErrorText="@_joinFieldErrors["code"]" />
                    <FlareButton FullWidth Variant="ButtonVariant.Tonal" Loading="_joining" OnClick="JoinAsync">Вступить</FlareButton>
                </FlareStack>
            </FlareCardContent>
        </FlareCard>

        <FlareStack Row Justify="FlareJustifyContent.Center" Wrap>
            @if (me.Families.Count > 0)
            {
                <FlareButton Variant="ButtonVariant.Text" Href="">Вернуться</FlareButton>
            }
            <FlareButton Variant="ButtonVariant.Text" OnClick="SignOutAsync">Выйти</FlareButton>
        </FlareStack>
    </FlareStack>
}

@code {
    private string? _familyName;
    private bool _seedExample = true;
    private string? _code;
    private string? _createError;
    private string? _joinError;
    private bool _creating;
    private bool _joining;
    private readonly FieldErrors _createFieldErrors = new();
    private readonly FieldErrors _joinFieldErrors = new();
    private FlareEditableFieldBase? _familyNameField;
    private FlareEditableFieldBase? _codeField;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.IsSignedIn) Nav.NavigateTo("login");
    }

    private async Task CreateAsync()
    {
        _createFieldErrors.Clear();
        if (string.IsNullOrWhiteSpace(_familyName))
        {
            _createFieldErrors["name"] = "Введите название семьи.";
            await _createFieldErrors.FocusFirstAsync(("name", _familyNameField));
            return;
        }

        _creating = true;
        _createError = null;
        try
        {
            var membership = await Api.CreateFamilyAsync(new CreateFamilyRequest(_familyName, _seedExample));
            await Session.SelectFamilyAsync(membership.FamilyId);
            Nav.NavigateTo("");
        }
        catch (ApiException e)
        {
            if (e.Message.Contains("Название", StringComparison.OrdinalIgnoreCase))
            {
                _createFieldErrors["name"] = e.Message;
                await _createFieldErrors.FocusFirstAsync(("name", _familyNameField));
            }
            else
            {
                _createError = e.Message;
            }
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task JoinAsync()
    {
        _joinFieldErrors.Clear();
        if (string.IsNullOrWhiteSpace(_code))
        {
            _joinFieldErrors["code"] = "Введите код приглашения.";
            await _joinFieldErrors.FocusFirstAsync(("code", _codeField));
            return;
        }

        _joining = true;
        _joinError = null;
        try
        {
            var membership = await Api.JoinFamilyAsync(new JoinFamilyRequest(_code));
            await Session.SelectFamilyAsync(membership.FamilyId);
            Nav.NavigateTo("");
        }
        catch (ApiException e)
        {
            if (e.Message.Contains("Код", StringComparison.OrdinalIgnoreCase))
            {
                _joinFieldErrors["code"] = e.Message;
                await _joinFieldErrors.FocusFirstAsync(("code", _codeField));
            }
            else
            {
                _joinError = e.Message;
            }
        }
        finally
        {
            _joining = false;
        }
    }

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("login");
    }
}
