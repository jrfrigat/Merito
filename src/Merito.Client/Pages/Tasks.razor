@page "/tasks"
@inject ApiClient Api
@inject Session Session
@inject IDialogService Dialogs
@inject ISnackbarService Snackbar

<PageTitle>Я сделал - Merito</PageTitle>

<RoleGate Role="FamilyRole.Child">
    <FlareStack Gap="FlareSpacing.Large">
        <PageHeader Title="Что ты сделал?" Subtitle="Нажми на дело - родитель проверит и начислит баллы">
            <Actions>
                <FlareButton Variant="ButtonVariant.Tonal" OnClick="@(() => OpenAsync(null))">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" /></LeadingIcon>
                    <ChildContent>Другое дело</ChildContent>
                </FlareButton>
            </Actions>
        </PageHeader>

        <LoadState Loading="_tasks is null" Error="@_error" OnRetry="LoadAsync">
            @if (_pending.Count > 0)
            {
                <FlareCard Variant="CardVariant.Outlined">
                    <FlareCardHeader Title="Ждут проверки" />
                    <FlareList TItem="object" Dense>
                        @foreach (var s in _pending)
                        {
                            <FlareListItem @key="s.Id" Primary="@s.Title" Secondary="@Format.When(s.SubmittedAt)">
                                <Leading><FlareIconView Value="@MaterialDesign3Icons.Regular.Pending" Color="FlareColor.Warning" /></Leading>
                                <Trailing>
                                    <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Undo" AriaLabel="Отменить отметку" OnClick="@(() => WithdrawAsync(s))" />
                                </Trailing>
                            </FlareListItem>
                        }
                    </FlareList>
                </FlareCard>
            }

            @if (_tasks is { Count: 0 })
            {
                <FlareEmptyState Title="Список заданий пуст" Description="Родитель еще не добавил задания. Можно отметить свое дело.">
                    <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Checklist" Size="3rem" /></IconContent>
                </FlareEmptyState>
            }
            else if (_tasks is not null)
            {
                <FlareTabs Variant="TabsVariant.Default">
                    @foreach (var group in _tasks.GroupBy(t => t.Category))
                    {
                        <FlareTab Label="@Format.Category(group.Key)" BadgeColor="FlareColor.Primary" Badge="@group.Count().ToString()">
                            <FlareList TItem="object">
                                @foreach (var task in group)
                                {
                                    <FlareListItem @key="task.Id" Primary="@task.Title" Secondary="@task.TimeOfDay" OnClick="@(() => OpenAsync(task))">
                                        <Leading>
                                            <FlareAvatar Color="FlareColor.Primary" Size="AvatarSize.Sm">
                                                <FallbackContent><FlareText Typo="TypographyScale.LabelLarge" Weight="FontWeight.Bold">@Format.Range(task.Points, task.MaxPoints)</FlareText></FallbackContent>
                                            </FlareAvatar>
                                        </Leading>
                                        <Trailing><FlareIconView Value="@MaterialDesign3Icons.Regular.AddCircle" Color="FlareColor.Primary" /></Trailing>
                                    </FlareListItem>
                                }
                            </FlareList>
                        </FlareTab>
                    }
                </FlareTabs>
            }
        </LoadState>
    </FlareStack>
</RoleGate>

@code {
    private List<TaskDto>? _tasks;
    private List<SubmissionDto> _pending = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsParent) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var tasks = Api.GetTasksAsync(Session.FamilyId);
            var pending = Api.GetSubmissionsAsync(Session.FamilyId, SubmissionStatus.Pending);
            _tasks = await tasks;
            _pending = await pending;
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    private async Task OpenAsync(TaskDto? task)
    {
        var result = await Dialogs.ShowAsync<SubmitDialog>(task is null ? "Другое дело" : "Отметить сделанным",
            new DialogParameters().Add(nameof(SubmitDialog.Task), task), new DialogOptions { Size = DialogSize.Sm });
        if (result.Cancelled) return;

        Snackbar.Show("Отправлено родителю на проверку", SnackbarSeverity.Success);
        await LoadAsync();
    }

    private async Task WithdrawAsync(SubmissionDto submission)
    {
        try
        {
            await Api.WithdrawAsync(Session.FamilyId, submission.Id);
            await LoadAsync();
        }
        catch (ApiException e)
        {
            Snackbar.Show(e.Message, SnackbarSeverity.Error);
        }
    }
}
