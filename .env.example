# Copy to .env and set a strong password before the first start.
POSTGRES_DB=merito
POSTGRES_USER=merito
POSTGRES_PASSWORD=change-me

# Generate one VAPID key pair as described in README.md or README.ru.md.
# Keep the private key in .env only and never commit it.
WebPush__PublicKey=
WebPush__PrivateKey=
WebPush__Subject=
